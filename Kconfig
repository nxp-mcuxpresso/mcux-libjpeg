# This is template Kconfig file

menu "Libjpeg"

	config MCUX_COMPONENT_middleware.libjpeg
	    bool "Libjpeg decoder"
	    default n
	    help
	        Enable middleware.libjpeg component

	config MCUX_COMPONENT_middleware.libjpeg.template
	    bool "Libjpeg template"
	    default n
	    help
	        Enable middleware.libjpeg.template component

endmenu
